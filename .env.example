# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=Fuel Guard API
APP_ENV=production                      # development | production
API_V1_PREFIX=/api/v1

# Comma-separated CORS origins — admin panel + local dev. No trailing slashes.
# The Flutter app does NOT need an entry (mobile is not CORS-subject).
ALLOWED_ORIGINS=https://your-admin-panel.example,http://localhost:3000

# ── Firebase (NEW project) ────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=your-new-firebase-project-id
# Firebase Console → Project settings → General → Web API Key
FIREBASE_API_KEY=your-web-api-key
# Railway/production: the ENTIRE service-account JSON as ONE line (never commit it):
#   python -c "import json,sys; print(json.dumps(json.load(open(sys.argv[1]))))" serviceAccountKey.json
FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"..."}
# Local dev alternative: drop the key file next to main.py and set the path
FIREBASE_CREDENTIALS_PATH=serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=your-bucket.firebasestorage.app

# ── JWT ───────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
# MUST be 32+ chars in production or startup refuses to boot.
JWT_SECRET_KEY=replace-with-64-char-random-hex-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── Email (optional — Firebase also delivers reset emails) ───────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=your-16-char-gmail-app-password
EMAIL_FROM=noreply@fuelguard.com

# ── OTP ───────────────────────────────────────────────────────────────────────
OTP_EXPIRE_MINUTES=10

# ── AI chatbot (optional — Groq, Llama 3.3 70B) ───────────────────────────────
GROQ_API_KEY=your-groq-api-key

# ── Cloudinary (REQUIRED for evidence photos + firmware OTA) ──────────────────
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ── Retention ─────────────────────────────────────────────────────────────────
EVIDENCE_RETENTION_DAYS=90
TELEMETRY_RETENTION_DAYS=30

# ── Rate limiting (per client IP, per minute) ─────────────────────────────────
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_IOT_PER_MINUTE=600
RATE_LIMIT_WRITE_PER_MINUTE=60
